# Aline server — copia a .env y pon TUS keys. Nunca subas el .env a GitHub.
# Genera la clave de cifrado con: openssl rand -hex 32

PORT=3001
# Si sirves el front desde otro dominio, ponlo aquí. En dev déjalo vacío (*).
ALLOWED_ORIGIN=

# --- Cifrado de chats (obligatorio para guardar en Postgres) ---
CHAT_ENCRYPTION_KEY=
# Opcional, solo si la clave de arriba es una frase y no hex/base64:
# CHAT_ENCRYPTION_SALT=aline-salt-v1

# --- Base de datos (PostgreSQL) ---
# Local con docker-compose: postgres://aline:aline@localhost:5432/aline
# En la nube (Neon / Railway / Supabase): pega aquí la URL que te den.
DATABASE_URL=

# --- Chat: together | replicate | ollama | custom | mock ---
CHAT_PROVIDER=together
# Together AI — Llama / Mistral open-source. Crea key en https://api.together.ai
TOGETHER_API_KEY=
TOGETHER_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Otros modelos Together: mistralai/Mixtral-8x7B-Instruct-v0.1
#   mistralai/Mistral-7B-Instruct-v0.3

# Replicate — si prefieres Replicate para chat
REPLICATE_API_TOKEN=
REPLICATE_CHAT_MODEL=meta/meta-llama-3-70b-instruct

# Tu propio servidor con GPUs (Ollama / vLLM / llama.cpp con endpoint OpenAI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# O Mistral local: OLLAMA_MODEL=mistral

# Endpoint OpenAI-compatible propio
CUSTOM_CHAT_ENDPOINT=
CUSTOM_CHAT_MODEL=
CUSTOM_API_KEY=

# --- Imagen: together | replicate | local-sd | mock ---
IMAGE_PROVIDER=together
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free
REPLICATE_IMAGE_MODEL=stability-ai/sdxl
# Tu propio Stable Diffusion (Automatic1111, API en :7860)
LOCAL_SD_URL=http://localhost:7860
